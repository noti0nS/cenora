{
  "name": "cenora",
  "private": true,
  "packageManager": "pnpm@11.0.8",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --filter @cenora/web build && pnpm --filter @cenora/api dev",
    "dev:web": "pnpm --filter @cenora/web dev",
    "build": "pnpm --filter @cenora/web build && pnpm --filter @cenora/api build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @cenora/api test",
    "test:e2e": "pnpm --filter @cenora/web build && playwright test",
    "deploy": "pnpm --filter @cenora/web build && pnpm --filter @cenora/api deploy",
    "deploy:check": "pnpm --filter @cenora/web build && pnpm --filter @cenora/api deploy:check",
    "db:migrate": "node scripts/database.mjs migrate",
    "recover": "node scripts/recover.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "typescript": "^7.0.2",
    "@types/node": "^26.6.5",
    "prettier": "^3.6.2"
  }
}
