# Optional: TMDB Read Access Token (v4) or API Key (v3)
TMDB_TOKEN=

# Optional: OMDb API key for IMDb scores
OMDB_KEY=

# Required in production for email access and invite passwords (development uses a local fallback)
AUTH_PEPPER=

# Optional in development (falls back to /api/dev/outbox); required in production for Resend email delivery
RESEND_API_KEY=
MAIL_FROM=Cenora <nao-responda@cenora.club>

# Optional: enables Cloudflare Turnstile verification on email endpoints
TURNSTILE_SECRET=
